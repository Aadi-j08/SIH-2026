# Database: Set DATABASE_URL for Neon / Supabase PostgreSQL, or leave empty for local SQLite
# DATABASE_URL=postgresql://user:password@ep-xyz.ap-southeast-1.aws.neon.tech/neondb?sslmode=require
SAHAKARSETU_DB=/data/sahakarsetu.db

# AI / ML: Google Gemini API (Free tier from aistudio.google.com)
GEMINI_API_KEY=your_gemini_api_key_here

# Security & Secrets

# Unlocks the sabha (council) portal, which can approve workers, verify documents
# and read every row in the tenant. SABHA-2026 is the shared demo code so the
# walkthrough works with no setup -- but it is public knowledge, because this
# repository is. Generate a real one before the host holds any real data:
#   python3 -c "import secrets; print(secrets.token_urlsafe(24))"
SAHAKARSETU_COUNCIL_CODE=SABHA-2026

# Demo data. Off by default: seeding creates a council account with a known
# password. Set both to run the walkthrough on a reachable host, then turn
# SAHAKARSETU_SEED_DEMO back to 0 (or remove it) when you are done.
# SAHAKARSETU_SEED_DEMO=1
# SAHAKARSETU_DEMO_PASSWORD=at-least-12-characters

# Local dev: http://localhost:5173,https://951dd6a2.sih-2026-hvs.pages.dev
SAHAKARSETU_CORS_ORIGINS=https://sahakarsetu-frontend.pages.dev
SAHAKARSETU_COOKIE_SECURE=1
SAHAKARSETU_COOKIE_SAMESITE=none
SAHAKARSETU_ENV=production                # Set to "production" to hide /docs and /openapi.json

# Frontend build
# VITE_API_BASE_URL=https://sahakarsetu-api.onrender.com
